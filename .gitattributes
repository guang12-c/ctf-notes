# 统一换行符：仓库里存 LF，不管在哪个系统都按 LF 处理
* text=auto eol=lf

# 这些是二进制文件，不要做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.mp4  binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.pdf  binary
*.zip  binary

# Markdown / 配置：强制 LF，避免 Windows 上被改成 CRLF
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.js       text eol=lf
*.py       text eol=lf
*.txt      text eol=lf
*.html     text eol=lf
